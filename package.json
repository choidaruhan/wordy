{
  "name": "wordy",
  "private": true,
  "type": "module",
  "scripts": {
    "copy:htmx": "node scripts/copy-htmx.mjs",
    "build:css": "tailwindcss -i src/styles/input.css -o public/styles.css --minify",
    "build": "npm run copy:htmx && npm run build:css",
    "dev:css": "tailwindcss -i src/styles/input.css -o public/styles.css --watch",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "npm run verify && npm run build",
    "verify": "npm run typecheck && npm test && npm run check:migrations && npm run check:seed",
    "db:local": "wrangler d1 migrations apply wordy-db --local",
    "db:remote": "wrangler d1 migrations apply wordy-db --remote",
    "check:seed": "node scripts/check-seed.mjs public/seeds/basic-1000.csv --expect 1000 && node scripts/check-seed.mjs public/seeds/function-100.csv --expect 100",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:integrity": "node scripts/check-integrity.mjs",
    "analyze:ratings": "node scripts/analyze-ratings.mjs",
    "db:backup": "node scripts/backup-d1.mjs",
    "db:backup:local": "node scripts/backup-d1.mjs --local",
    "db:restore:drill": "node scripts/restore-drill.mjs",
    "db:restore:drill:remote": "node scripts/restore-drill.mjs --remote",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "make:icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/cli": "^4.3.4",
    "esbuild": "^0.28.2",
    "htmx.org": "^2.0.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
