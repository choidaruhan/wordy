{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordy",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordy-db",
      "database_id": "2298df33-cdfd-4b3b-8738-dff8486b124c",
      "migrations_dir": "migrations"
    }
  ]
}
